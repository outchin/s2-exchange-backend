# Django Settings
DJANGO_SECRET_KEY=change-me-generate-with-django-get-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Superuser Credentials (REQUIRED - set in Railway Variables)
# NO DEFAULTS - You must set these in Railway dashboard
DJANGO_SUPERUSER_EMAIL=your-email@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password-here
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Database (automatically set by Railway when using PostgreSQL)
# For local development, you can use SQLite (no need to set DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:port/database

# CORS Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Google OAuth2 Settings (optional)
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# Firebase Settings (optional)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
FIREBASE_RATES_PATH=exchange_rates

# Production-only settings (set these on Railway)
# PORT=8000  # Automatically set by Railway
# RAILWAY_ENVIRONMENT=production
