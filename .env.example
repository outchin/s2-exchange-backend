DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_PORT=8000

DATABASE_URL=your-railway-database-url-here

# Google OAuth2 Client ID - Optional: Leave empty to skip ID token verification
# If using single Client ID approach (mobile only), leave this empty
# If you need backend verification, set to your Web Client ID
GOOGLE_OAUTH2_CLIENT_ID=

FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
FIREBASE_RATES_PATH=exchange_rates
